{
  "expo": {
    "name": "BookMyDarzi Operations",
    "slug": "bookmydarzi-admin",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "bookmydarzi-admin",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.bookmydarzi.admin",
      "buildNumber": "15",
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        },
        "NSFaceIDUsageDescription": "BookMyDarzi Admin uses Face ID to unlock the app after login.",
        "NSLocationWhenInUseUsageDescription": "BookMyDarzi Admin uses your location to mark you online for nearby pickup and delivery broadcasts.",
        "NSCameraUsageDescription": "BookMyDarzi Admin uses the camera to take photos for catalog items, tailor applications, and order progress.",
        "NSPhotoLibraryUsageDescription": "BookMyDarzi Admin uses your photo library to upload images for catalog items, tailor applications, and order progress.",
        "NSMicrophoneUsageDescription": "BookMyDarzi Admin uses your microphone to play order voice notes."
      },
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "package": "com.bookmydarzi.admin",
      "versionCode": 4,
      "predictiveBackGestureEnabled": false,
      "softwareKeyboardLayoutMode": "resize",
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#ffffff",
          "image": "./assets/splash-icon.png",
          "imageWidth": 200
        }
      ],
      "expo-secure-store",
      "expo-document-picker",
      [
        "expo-notifications",
        {
          "color": "#1aa3b0"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "BookMyDarzi Admin needs access to your photos to upload order progress photos.",
          "cameraPermission": "BookMyDarzi Admin needs camera access to capture order progress photos.",
          "microphonePermission": false
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {}
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "BookMyDarzi Admin uses your location to match you with nearby deliveries while you're online."
        }
      ],
      "@react-native-community/datetimepicker",
      [
        "expo-audio",
        {
          "microphonePermission": false
        }
      ],
      "expo-asset",
      "@sentry/react-native",
      "expo-font",
      "expo-image",
      "expo-sharing",
      "expo-status-bar"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "9d115056-a333-4128-a64d-03af3dab04f9"
      }
    },
    "owner": "viveksaraswat49"
  }
}
